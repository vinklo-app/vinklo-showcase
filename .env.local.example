# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email
RESEND_API_KEY=

# Analytics
POSTHOG_KEY=

# Admin (emails con acceso a /admin, separados por comas)
ADMIN_EMAILS=

# Cron (Vercel manda Authorization: Bearer $CRON_SECRET al cron diario)
CRON_SECRET=

# IA: API directa de Anthropic Console. Secreto SOLO del servidor.
# No usa los créditos de AI Gateway. No hay fallback automático al gateway.
VINKLO_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# "off" apaga solo el asistente CRM.
VINKLO_AI_CRM=
# Para volver al proveedor anterior, elegid VINKLO_AI_PROVIDER=gateway.
AI_GATEWAY_API_KEY=
VERCEL_OIDC_TOKEN=
# "off" apaga toda la IA (editor, lectura de la idea y pulido de la historia).
VINKLO_AI_EDITOR=
# Modelos: Claude directo usa IDs claude-*, gateway usa proveedor/modelo.
# Vacío = Sonnet 5.5 para editor/plano; Haiku 5.5 para idea/historia/CRM.
# Los valores siguientes solo describen el modo gateway anterior:
#   editor  google/gemini-2.5-flash       (lib/ai/site-editor.ts)
#   idea    google/gemini-2.5-flash-lite  (lib/ai/idea-reader.ts)
#   historia google/gemini-2.5-flash-lite (lib/ai/story-polish.ts)
# OJO: si se fija en Vercel, fijadlo en Production Y Preview (y aquí) para que
# todas las versiones usen el mismo modelo.
VINKLO_AI_EDITOR_MODEL=
VINKLO_AI_IDEA_MODEL=
VINKLO_AI_STORY_MODEL=
VINKLO_AI_VISION_MODEL=
VINKLO_AI_SEATING_MODEL=
VINKLO_AI_CRM_MODEL=
# Tope global de propuestas del editor al día (todas las parejas). Vacío = 300.
VINKLO_AI_EDITOR_DAILY_BUDGET=

# Sugerencias de lugares (/api/lugares, solo servidor; plan maestro §11).
# Con clave: Google Places API (New). Vacío: Photon (OpenStreetMap, sin clave).
# Nunca NEXT_PUBLIC_: la clave no debe llegar al navegador.
GOOGLE_MAPS_API_KEY=

# «Continuar con Google» en /login. "on" lo enseña; cualquier otro valor lo
# oculta. Solo encender con el proveedor Google ya configurado en Supabase.
# Se fija al compilar: cambiarlo exige desplegar de nuevo.
NEXT_PUBLIC_GOOGLE_LOGIN=
